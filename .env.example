# Supabase (https://supabase.com/dashboard)
# Server-only: never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PonsVaultLauncher on Robinhood Chain (chain 4663).
# Until this is set, the launch form offers vault templates as unavailable and
# launches straight through the pons factory with fees going to your own wallet.
# Deploy with: cd contracts && forge script script/DeployPonsVault.s.sol
NEXT_PUBLIC_PONSVAULT_LAUNCHER=

# Keeper — the scheduled job that calls run() on vaults so burns happen without
# anyone pressing a button. Entirely optional: vaults stay permissionless, so
# without a keeper they simply wait for someone else to trigger them.
#
# This wallet only ever pays gas. It has no authority over any vault and never
# holds fees, so fund it with a small ETH balance and nothing else.
KEEPER_PRIVATE_KEY=
# Shared secret for GET /api/keeper/tick. On Vercel, set CRON_SECRET instead and
# the built-in cron will authenticate itself.
KEEPER_SECRET=
# Throttles. The schedule only decides how often the keeper *looks*; these decide
# how often it acts. Without them it burns every trickle of fees the moment it
# arrives, turning the burn history into dust. Gas here is far too cheap for the
# gas-cost ratio alone to hold anything back.
# The floor is the real control, since the vaults themselves have no timer: a run
# spends everything, so the cadence is however fast trading refills it. The floor
# drops to the dust value once a vault is overdue, so a slow token still burns
# daily instead of looking inert for a week.
# KEEPER_MIN_INTERVAL_SECONDS=300    # per-vault backstop; keep at or above the cron interval
# KEEPER_MIN_WETH=0.025              # normal floor; keep in step with BUYBACK_BURN_DEFAULTS

# KEEPER_MAX_IDLE_SECONDS=86400      # after this long, accept the dust floor instead
# KEEPER_DUST_WETH=0.002             # the overdue floor, still ~60x a run's gas
# KEEPER_MIN_VALUE_RATIO=3           # and never spend more on gas than it is worth
# Only for scripts/keeper-tick.mjs, when the schedule runs outside the host.
# KEEPER_URL=https://your-deployment.example
# The keeper finds vaults from the database and from the launcher's own Launched
# events, so a launch that never got recorded still gets serviced. The event scan
# starts at genesis unless this narrows it to the launcher's deployment block.
# PONSVAULT_LAUNCHER_START_BLOCK=

# Optional: pons image upload (server-side). pons is tried first; Pinata is used when pons is unreachable.
# PONS_API_BASE=https://ponsfamily.com
# PINATA_JWT=your_pinata_jwt
