# Supabase (https://supabase.com/dashboard)
# Server-only: never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# The PonsVault contract addresses are NOT configured here. They live in
# src/lib/pons/deployments.ts, because the launcher is the on-chain deployer of
# every token it creates and so can never move — and keeping all four together
# means a redeploy is one edit that cannot half-land.
# Deploy with: cd contracts && forge script script/DeployPonsVault.s.sol

# The Vault Seats addresses are not configured here either, for the same reason:
# they live in src/lib/seats/deployments.ts. Paste the addresses there after a deploy.
# Deploy with: cd contracts && forge script script/DeployPonsSeats.s.sol --rpc-url robinhood --broadcast

# Keeper — the scheduled job that calls run() on vaults so burns happen without
# anyone pressing a button. Entirely optional: vaults stay permissionless, so
# without a keeper they simply wait for someone else to trigger them.
#
# This wallet only ever pays gas. It has no authority over any vault and never
# holds fees, so fund it with a small ETH balance and nothing else.
KEEPER_PRIVATE_KEY=
# Shared secret for GET /api/keeper/tick. On Vercel, set CRON_SECRET instead and
# the built-in cron will authenticate itself.
KEEPER_SECRET=
# Throttles. The schedule only decides how often the keeper *looks*. How much
# must accrue before a run is the creator's own minHarvestWei on the vault —
# the keeper has no second WETH floor. These only stop wasteful or duplicate work.
# KEEPER_MIN_INTERVAL_SECONDS=300    # per-vault backstop; keep at or above the cron interval
# KEEPER_MIN_VALUE_RATIO=3           # never spend more on gas than the harvest is worth
# Only for scripts/keeper-tick.mjs, when the schedule runs outside the host.
# KEEPER_URL=https://your-deployment.example

# Optional: pons image upload (server-side). pons is tried first; Pinata is used when pons is unreachable.
# PONS_API_BASE=https://ponsfamily.com
# PINATA_JWT=your_pinata_jwt

# Gateway the browser loads ipfs:// art through. Defaults to Pinata's shared gateway, which serves our
# own pins instantly — public gateways only find a CID hours later, so a new series would show no art.
# Set this to a dedicated gateway (https://your-name.mypinata.cloud) to avoid the shared-gateway queue.
# NEXT_PUBLIC_IPFS_GATEWAY=

# PonsVault Originals art pack. The same 96 files back every Originals series, so pin them once with
# `npm run originals:pin` and paste the CID here — launches then only write per-series metadata.
# Leave unset and the first Originals launch pins the art itself (slower, but works).
# PONS_ORIGINALS_ART_CID=
