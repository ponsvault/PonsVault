# Robinhood Chain RPC used by fork tests and deploy scripts.
# The public endpoint below works but is aggressively rate-limited. For a reliable suite use a
# dedicated endpoint from one of the providers Robinhood lists:
#   Alchemy    https://robinhood-mainnet.g.alchemy.com/v2/<API_KEY>   (recommended, free tier is enough)
#   QuickNode  https://<endpoint>.robinhood-mainnet.quiknode.pro/<TOKEN>
#   dRPC       https://lb.drpc.org/ogrpc?network=robinhood&dkey=<KEY>  (pay as you go)
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Deploy key, 0x-prefixed. Never commit a funded key.
PRIVATE_KEY=

# Blockscout key for `forge verify-contract`.
BLOCKSCOUT_API_KEY=
